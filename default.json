{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigests"
  ],

  "timezone": "Europe/Berlin",
  "schedule": [
    "before 10am on Saturday"
  ],

  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "dependencyDashboard": true,

  "osvVulnerabilityAlerts": true,

  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",

  "separateMajorMinor": true,

  "packageRules": [
    {
      "description": "Automerge every non-major update once it is 3 days old (minimumReleaseAge, against supply chain attacks); patches grouped into one PR per repo",
      "matchUpdateTypes": [
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "groupName": "all patch dependencies",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Automerge minor updates once they are 3 days old, one PR each so a breaking minor does not block the others",
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Major updates: a pull request to review and merge by hand, never automerged",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
