{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigests"
  ],

  "timezone": "Europe/Berlin",
  "schedule": ["before 10am on Saturday"],

  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "dependencyDashboard": true,

  "osvVulnerabilityAlerts": true,

  "minimumReleaseAge": "3 days",

  "separateMajorMinor": true,

  "packageRules": [
    {
      "description": "Group all patch updates into a single PR per repo",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "groupName": "all patch dependencies",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Automerge minor updates for low-risk dev tooling (type annotations, linters, formatters, test tools)",
      "matchDepTypes": ["devDependencies"],
      "matchPackagePatterns": [
        "^@types/",
        "^eslint",
        "^prettier",
        "^vitest",
        "^@vitest/",
        "^@testing-library/",
        "^typescript$",
        "^tsx$",
        "^ts-node$"
      ],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "dev tooling (low risk)",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Automerge minor updates for other devDependencies after a longer wait",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor"],
      "minimumReleaseAge": "7 days",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Never automerge major updates — always require manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Never automerge runtime/production dependency minor+ updates",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    }
  ]
}
